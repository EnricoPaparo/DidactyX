{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DidactyX lesson content v1",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "lead": {
      "type": "string"
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "paragraph"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "definition"
                      ]
                    },
                    "term": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "term",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "example"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "conclusion": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "steps",
                    "conclusion"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "code"
                      ]
                    },
                    "language": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "execution": {
                      "type": "string",
                      "enum": [
                        "check",
                        "illustration"
                      ]
                    },
                    "cases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "stdin": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "stdout": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "stdin",
                          "stdout"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "language",
                    "code",
                    "explanation",
                    "execution",
                    "cases"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "items"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "table"
                      ]
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "headers",
                    "rows"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "callout"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "formula"
                      ]
                    },
                    "expression": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "expression",
                    "explanation"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "objective_ids",
          "blocks"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "self_check": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "question",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "required": [
          "term",
          "definition"
        ],
        "additionalProperties": false
      }
    },
    "continuity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "section_id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "prerequisite_support": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lesson_id": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teacher_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "lead",
    "objective_ids",
    "sections",
    "summary",
    "self_check",
    "terms",
    "continuity",
    "prerequisite_support",
    "source_ids",
    "teacher_notes"
  ],
  "additionalProperties": false
}
